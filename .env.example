# --- Input ---
LOG_FILE_PATH=./data/app.log
LOG_FORMAT=auto
TAIL_POLL_INTERVAL_SEC=0.2

# --- Windowing ---
WINDOW_SECONDS=60
EVAL_INTERVAL_SEC=5
MIN_EVENTS_IN_WINDOW=20

# --- Baseline ---
BASELINE_WARMUP_SAMPLES=24
BASELINE_ALPHA=0.05
BASELINE_MIN_STD=0.01
FREEZE_BASELINE_DURING_ALERT=true
BASELINE_PATH=./data/baseline.json

# --- Detection thresholds ---
Z_LOW=3.0
Z_MEDIUM=4.5
Z_HIGH=6.5
Z_CRITICAL=9.0
ABS_RATE_CRITICAL=0.50
MIN_ABS_RATE=0.05
CONFIRM_TICKS=2
RESOLVE_Z=2.0
RESOLVE_TICKS=3
ALERT_COOLDOWN_SEC=120

# --- Alert publishing ---
PUBLISH_MODE=dry_run
AWS_REGION=ap-south-1
CW_LOG_GROUP=/hackathon/log-anomaly-detector
CW_LOG_STREAM=alerts
SNS_TOPIC_ARN=
SNS_MIN_SEVERITY=MEDIUM
AWS_ENDPOINT_URL=
PUBLISH_MAX_RETRIES=3
PUBLISH_BACKOFF_BASE_SEC=1.0
# Custom metrics (ErrorRate, ZScore, EventsPerSec, OpenAlerts) in namespace LogAnomaly; aws mode only
CW_METRICS_ENABLED=true
CW_METRICS_INTERVAL_SEC=60

# --- API ---
CORS_ORIGINS=http://localhost:5173
RING_BUFFER_SIZE=2000
ENABLE_SIM=true
