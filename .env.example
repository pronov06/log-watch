# --- Input ---
LOG_FILE_PATH=./data/app.log
# Extra files/globs to tail, comma-separated (empty = LOG_FILE_PATH only), e.g.
# LOG_SOURCES=/var/log/nginx/access.log,/var/log/myapp/*.log
LOG_SOURCES=
# auto | text | json | python | nginx | syslog  (auto detects per line)
LOG_FORMAT=auto
SOURCE_RESCAN_SEC=2
TAIL_POLL_INTERVAL_SEC=0.2

# --- Windowing ---  (numbers behind these defaults: docs/detector-benchmark.md)
# Main window: alerts at any severity. 5 min ignores short self-healing blips and low-traffic noise.
WINDOW_SECONDS=300
# Fast window: may only alert at >= FAST_MIN_SEVERITY, so big spikes are still caught in seconds.
# 0 disables it (single-window detection).
FAST_WINDOW_SECONDS=60
FAST_MIN_SEVERITY=HIGH
EVAL_INTERVAL_SEC=5
# Low-traffic gate: skip windows with fewer events (1 error in 3 requests is not 33%)
MIN_EVENTS_IN_WINDOW=20

# --- Baseline ---
# mad = median ± scaled MAD (robust to spikes, default) | ewma = mean ± std (for comparison)
BASELINE_METHOD=mad
BASELINE_HISTORY_SEC=1800
BASELINE_WARMUP_SAMPLES=24
BASELINE_ALPHA=0.05
# Scale floor: MAD/std is ~0 when errors are ~always 0; without a floor every blip is "infinite" z
BASELINE_MIN_STD=0.01
FREEZE_BASELINE_DURING_ALERT=true
BASELINE_PATH=./data/baseline.json
# Same-hour baseline: compare with the same time on previous days (±tolerance) once
# SEASONAL_MIN_DAYS of history exist; the rolling baseline is used until then.
SEASONAL_ENABLED=true
SEASONAL_DAY_SECONDS=86400
SEASONAL_BUCKETS_PER_DAY=288
SEASONAL_TOLERANCE_SLOTS=3
SEASONAL_MIN_DAYS=3
SEASONAL_MAX_DAYS=7

# --- Detection thresholds ---
Z_LOW=3.0
Z_MEDIUM=4.5
Z_HIGH=6.5
Z_CRITICAL=9.0
ABS_RATE_CRITICAL=0.50
MIN_ABS_RATE=0.05
CONFIRM_TICKS=2
RESOLVE_Z=2.0
RESOLVE_TICKS=3
ALERT_COOLDOWN_SEC=120

# --- Alert publishing ---
PUBLISH_MODE=dry_run
AWS_REGION=ap-south-1
CW_LOG_GROUP=/hackathon/log-anomaly-detector
CW_LOG_STREAM=alerts
SNS_TOPIC_ARN=
SNS_MIN_SEVERITY=MEDIUM
AWS_ENDPOINT_URL=
PUBLISH_MAX_RETRIES=3
PUBLISH_BACKOFF_BASE_SEC=1.0
# Custom metrics (ErrorRate, ZScore, EventsPerSec, OpenAlerts) in namespace LogAnomaly; aws mode only
CW_METRICS_ENABLED=true
CW_METRICS_INTERVAL_SEC=60

# --- API ---
CORS_ORIGINS=http://localhost:5173
RING_BUFFER_SIZE=2000
ENABLE_SIM=true

# --- App logging (the detector's own logs) ---
LOG_JSON=false
APP_LOG_LEVEL=INFO
